{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile and emergency alert notification preferences.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner Firebase Auth UID."
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 160,
          "description": "Notification recipient email address."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Display name for the household inventory owner."
        },
        "emailNotificationsEnabled": {
          "type": "boolean",
          "description": "Whether email expiration digests are enabled."
        },
        "pushNotificationsEnabled": {
          "type": "boolean",
          "description": "Whether browser push notifications are enabled."
        },
        "alertThresholdDays": {
          "type": "integer",
          "description": "Number of days before expiration to trigger alerts (1 to 365)."
        },
        "digestFrequency": {
          "type": "string",
          "enum": ["immediate", "daily", "weekly"],
          "description": "Preferred notification cadence."
        },
        "webhookUrl": {
          "type": "string",
          "maxLength": 300,
          "description": "Optional webhook endpoint for push relay (Slack, Discord, ntfy)."
        },
        "householdSize": {
          "type": "integer",
          "description": "Number of household members for calorie-day reserve calculations (1 to 50)."
        },
        "preferredLocale": {
          "type": "string",
          "enum": ["en", "pt-BR", "es", "fr", "de"],
          "description": "Preferred UI and email notification locale."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "uid",
        "email",
        "displayName",
        "emailNotificationsEnabled",
        "pushNotificationsEnabled",
        "alertThresholdDays",
        "digestFrequency",
        "householdSize",
        "createdAt",
        "updatedAt"
      ]
    },
    "PantryItem": {
      "title": "PantryItem",
      "description": "An emergency food supply item tracked for stock levels and expiration.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner Firebase Auth UID."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Supply item name."
        },
        "foodGroup": {
          "type": "string",
          "enum": [
            "Water & Hydration",
            "Grains & Starches",
            "Proteins & Legumes",
            "Fruits & Vegetables",
            "Dairy & Alternatives",
            "Fats, Oils & Condiments",
            "Ready-to-Eat Meals"
          ],
          "description": "Nutritional food group classification."
        },
        "quantity": {
          "type": "number",
          "description": "Current quantity on hand (0 to 100000)."
        },
        "targetMinQuantity": {
          "type": "number",
          "description": "Target minimum stock level (0 to 100000)."
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24,
          "description": "Measurement unit (cans, kg, L, pouches, packs)."
        },
        "caloriesPerUnit": {
          "type": "number",
          "description": "Estimated kilocalories per unit (0 to 50000)."
        },
        "storageLocation": {
          "type": "string",
          "maxLength": 80,
          "description": "Physical storage location."
        },
        "expirationDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "minLength": 10,
          "maxLength": 10,
          "description": "Expiration or best-by date in YYYY-MM-DD format."
        },
        "notes": {
          "type": "string",
          "maxLength": 300,
          "description": "Optional rotation or preparation notes."
        },
        "status": {
          "type": "string",
          "enum": ["active", "consumed", "discarded"],
          "description": "Lifecycle status of the supply batch."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "userId",
        "name",
        "foodGroup",
        "quantity",
        "targetMinQuantity",
        "unit",
        "caloriesPerUnit",
        "storageLocation",
        "expirationDate",
        "notes",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "NotificationLog": {
      "title": "NotificationLog",
      "description": "Audit record of an expiration push, email, or webhook alert.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner Firebase Auth UID."
        },
        "channel": {
          "type": "string",
          "enum": ["push", "email", "webhook"],
          "description": "Notification delivery channel."
        },
        "recipient": {
          "type": "string",
          "maxLength": 160,
          "description": "Email address, browser target, or webhook endpoint."
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "description": "Notification headline or email subject."
        },
        "itemCount": {
          "type": "integer",
          "description": "Number of expiring or expired items included in the alert."
        },
        "deliveryStatus": {
          "type": "string",
          "enum": ["delivered", "logged_unconfigured", "failed"],
          "description": "Actual delivery outcome."
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "Concise summary of notified items."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        }
      },
      "required": [
        "userId",
        "channel",
        "recipient",
        "subject",
        "itemCount",
        "deliveryStatus",
        "summary",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profile and notification settings (owner-only read/write, no list)."
    },
    "/pantry_items/{itemId}": {
      "schema": { "$ref": "#/entities/PantryItem" },
      "description": "Emergency food supply items scoped by userId."
    },
    "/notification_logs/{logId}": {
      "schema": { "$ref": "#/entities/NotificationLog" },
      "description": "Expiration alert history scoped by userId."
    }
  }
}
